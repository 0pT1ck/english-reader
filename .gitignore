# Learning data and dictionary — never versioned (size + privacy).
# learning.db holds irreplaceable study records; back it up via the admin console.
data/
*.db
*.db-shm
*.db-wal
*.db-journal

# Python
.venv/
__pycache__/
*.py[cod]

# Local configuration and secrets
.env
.env.local
# API keys. Already covered by data/, listed again because committing this one
# would publish live credentials.
data/secrets.json

# Logs
logs/
*.log

# OS
Thumbs.db
.DS_Store

# Visual Studio scratch, and Swift build output
.vs/
.build/

# 构建工具的本地检出，不进版本控制
.tooling/

# Swift 构建产物
client/.build/

# 命令行客户端的本地状态（发件箱、缓存）
client/.ercli/

# iOS 工程文件是 XcodeGen 从 client/App/project.yml 生成的。
# 提交它没有意义：这台机器上没有 Xcode，改不了也读不懂，
# 而且它是每次生成都会变的机器产物。要看工程结构就看那份 YAML。
client/App/*.xcodeproj/
client/App/DerivedData/
