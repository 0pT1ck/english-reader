# Copy to .env next to this file and fill it in. That file is git-ignored — it
# holds the admin password, and this repository is public.
#
#   cp env.example .env
#   docker compose --env-file .env up -d --build

# --- required ---------------------------------------------------------------

# Admin console password. Generate one, do not invent one: /admin is reachable
# from the internet on this deployment and this string is the only thing in
# front of a button that downloads the entire learning database.
#   openssl rand -base64 32
ER_ADMIN_SECRET=

# --- storage ----------------------------------------------------------------

# Host directory holding the four SQLite files, relative to this file or
# absolute. Bind-mounted so the databases stay visible on the host.
ER_DATA_DIR=../data

# The container writes to that directory as this uid, and the kernel compares
# numbers, not names. Either `chown -R 10001:10001` the data directory and leave
# these alone, or set them to `id -u` and `id -g` of whoever owns it.
ER_UID=10001
ER_GID=10001

# --- optional ---------------------------------------------------------------

# Outbound proxy for LLM APIs and Bark. Normally empty on a cloud host.
ER_PROXY_URL=

ER_LOG_LEVEL=INFO

# The nightly generation job is scheduled as local 04:00 and the review day ends
# at local midnight, so a container left on UTC would generate at noon and roll
# the day over at 08:00. Nothing logs a complaint when that happens.
TZ=Asia/Shanghai

# --- not here ---------------------------------------------------------------
#
# The domain, the certificate and the public port belong to the host's shared
# Caddy, which has its own directory and its own compose file. This stack
# publishes no port and only joins the `proxy` network:
#
#   docker network create proxy
