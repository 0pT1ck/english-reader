# Copy to docker/.env and fill in. That file is git-ignored — it holds the admin
# password and a DNS provider key, and this repository is public.
#
#   cp docker/env.example docker/.env
#   docker compose -f docker/docker-compose.yml --env-file docker/.env up -d --build

# --- required ---------------------------------------------------------------

# Admin console password. Generate one, do not invent one: on this deployment
# /admin is reachable from the internet and this string is the only thing in
# front of a button that downloads the entire learning database.
#   openssl rand -base64 32
ER_ADMIN_SECRET=

# The domain the phone will connect to. Must be a domain, not an IP: iOS will
# not accept a certificate for a bare address, and no public CA issues one.
ER_DOMAIN=reader.example.com

# Where expiry warnings from Let's Encrypt go.
ER_ACME_EMAIL=

# DNS-01 credentials, for the provider compiled into docker/Dockerfile.caddy
# (Aliyun DNS by default). A RAM user with AliyunDNSFullAccess is enough —
# do not use the account's primary key here.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# --- 备案 ---------------------------------------------------------------------

# 8443 while the filing is pending: an unfiled domain on a mainland IP is
# blocked on 443, and a high port is not. iOS does not mind the port as long as
# the certificate is valid — the phone connects to https://your.domain:8443
# and the app's settings screen takes the whole URL including the port.
# Set this to 443 once 备案 clears.
ER_HTTPS_PORT=8443

# Port 80 stays on the loopback interface. Nothing needs it: DNS-01 does not use
# it, and publishing it on an unfiled domain achieves nothing but noise in the
# logs. After 备案, "80" here turns on Caddy's automatic HTTP→HTTPS redirect.
ER_HTTP_PORT=127.0.0.1:8080

# --- optional ---------------------------------------------------------------

# Host directory holding the four SQLite files, relative to docker/ or absolute.
ER_DATA_DIR=../data

# The container writes to that directory as this uid, and the kernel compares
# numbers, not names. Either `chown -R 10001:10001` the data directory and leave
# these alone, or set them to `id -u` and `id -g` of whoever owns it.
ER_UID=10001
ER_GID=10001

# Outbound proxy for LLM APIs and Bark. Normally empty on an Aliyun host —
# it reaches the relay directly.
ER_PROXY_URL=

ER_LOG_LEVEL=INFO

# The nightly generation job is scheduled as local 04:00 and the review day
# ends at local midnight, so a container left on UTC would generate at noon and
# roll the day over at 08:00. Nothing logs a complaint when that happens.
TZ=Asia/Shanghai
